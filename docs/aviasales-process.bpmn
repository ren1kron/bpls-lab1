<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_Aviasales_Camunda"
                  targetNamespace="http://example.com/aviasales/monetization"
                  exporter="Camunda Modeler"
                  exporterVersion="5.43.1">

  <bpmn:message id="Message_CreativeUploadFinished" name="CreativeUploadFinished" />
  <bpmn:message id="Message_PaymentSucceeded" name="PaymentSucceeded" />
  <bpmn:message id="Message_PaymentCanceled" name="PaymentCanceled" />
  <bpmn:message id="Message_PauseRequested" name="PauseRequested" />

  <bpmn:process id="aviasales-campaign-launch" name="Запуск рекламной кампании" isExecutable="true"
                camunda:historyTimeToLive="P180D">
    <bpmn:startEvent id="StartEvent_CreateCampaign" name="Создать кампанию" camunda:initiator="ownerUsername">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="ownerUsername" label="Владелец кампании" type="string" />
          <camunda:formField id="name" label="Название" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="objective" label="Цель" type="enum">
            <camunda:value id="TRAFFIC" name="TRAFFIC" />
            <camunda:value id="APP_INSTALL" name="APP_INSTALL" />
            <camunda:value id="LEAD_GENERATION" name="LEAD_GENERATION" />
            <camunda:value id="AWARENESS" name="AWARENESS" />
            <camunda:value id="RETARGETING" name="RETARGETING" />
          </camunda:formField>
          <camunda:formField id="campaignType" label="Тип кампании" type="enum">
            <camunda:value id="DISPLAY" name="DISPLAY" />
            <camunda:value id="NATIVE" name="NATIVE" />
            <camunda:value id="PUSH" name="PUSH" />
            <camunda:value id="EMAIL" name="EMAIL" />
            <camunda:value id="SPONSORED_LISTING" name="SPONSORED_LISTING" />
          </camunda:formField>
          <camunda:formField id="url" label="URL" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="startMode" label="Режим запуска" type="enum">
            <camunda:value id="MANUAL_START" name="MANUAL_START" />
            <camunda:value id="AUTO_START_WHEN_APPROVED" name="AUTO_START_WHEN_APPROVED" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_CreateDraft</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="ServiceTask_CreateDraft" name="Создать черновик"
                      camunda:type="external" camunda:topic="campaign-create-draft">
      <bpmn:incoming>Flow_Start_CreateDraft</bpmn:incoming>
      <bpmn:outgoing>Flow_Draft_Configure</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_ConfigureCampaign" name="Настроить кампанию"
                   camunda:candidateUsers="${ownerUsername}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="budgetAmount" label="Бюджет" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="requestedStartAt" label="Дата старта ISO-8601" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="durationDays" label="Длительность в днях" type="long">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Draft_Configure</bpmn:incoming>
      <bpmn:outgoing>Flow_Configure_Service</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_ConfigureCampaign" name="Сохранить настройки"
                      camunda:type="external" camunda:topic="campaign-configure">
      <bpmn:incoming>Flow_Configure_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_Configured_Upload</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_UploadCreatives" name="Загрузить креатив"
                   camunda:candidateUsers="${ownerUsername}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="creativeUrl" label="URL креатива" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="creativeType" label="Тип креатива" type="enum">
            <camunda:value id="IMAGE" name="IMAGE" />
            <camunda:value id="VIDEO" name="VIDEO" />
            <camunda:value id="HTML5" name="HTML5" />
          </camunda:formField>
          <camunda:formField id="uploadMore" label="Загрузить еще после обработки" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Configured_Upload</bpmn:incoming>
      <bpmn:incoming>Flow_UploadMore_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_UploadFailed_Retry</bpmn:incoming>
      <bpmn:incoming>Flow_Fix_UploadAgain</bpmn:incoming>
      <bpmn:outgoing>Flow_Upload_Service</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_ScheduleCreativeUpload" name="Поставить загрузку креатива в Kafka"
                      camunda:type="external" camunda:topic="creative-schedule-upload">
      <bpmn:incoming>Flow_Upload_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_Upload_WaitResult</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="IntermediateMessage_CreativeUploadFinished" name="Креатив обработан">
      <bpmn:incoming>Flow_Upload_WaitResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Upload_ResultGateway</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CreativeUploadFinished" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_CreativeUploadResult" name="Загрузка успешна?" default="Flow_UploadCompleted">
      <bpmn:incoming>Flow_Upload_ResultGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_UploadFailed_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_UploadCompleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_UploadMore" name="Еще креатив?" default="Flow_UploadMore_No">
      <bpmn:incoming>Flow_UploadCompleted</bpmn:incoming>
      <bpmn:outgoing>Flow_UploadMore_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_UploadMore_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_SubmitForCheck" name="Отправить на проверку"
                   camunda:candidateUsers="${ownerUsername}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="operationUsername" label="Пользователь" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_UploadMore_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Service</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_SubmitForModeration" name="Перевести в модерацию"
                      camunda:type="external" camunda:topic="campaign-submit">
      <bpmn:incoming>Flow_Submit_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Moderation</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_ManualModeration" name="Ручная модерация"
                   camunda:candidateGroups="COMPANYMODERATOR">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="moderatorUsername" label="Модератор" type="string" />
          <camunda:formField id="moderationApproved" label="Одобрено" type="boolean" />
          <camunda:formField id="moderationComment" label="Комментарий" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Submit_Moderation</bpmn:incoming>
      <bpmn:outgoing>Flow_Moderation_Service</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_ModerationDecision" name="Обработать решение модерации"
                      camunda:type="external" camunda:topic="moderation-decision">
      <bpmn:incoming>Flow_Moderation_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_Moderation_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ModerationApproved" name="Одобрено?" default="Flow_Moderation_Rejected">
      <bpmn:incoming>Flow_Moderation_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Moderation_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Moderation_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_FixAfterRejection" name="Доработать кампанию"
                   camunda:candidateUsers="${ownerUsername}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="name" label="Название" type="string" />
          <camunda:formField id="url" label="URL" type="string" />
          <camunda:formField id="budgetAmount" label="Бюджет" type="string" />
          <camunda:formField id="requestedStartAt" label="Дата старта ISO-8601" type="string" />
          <camunda:formField id="durationDays" label="Длительность в днях" type="long" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Moderation_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Fix_Service</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_ReconfigureAfterRejection" name="Сохранить доработку"
                      camunda:type="external" camunda:topic="campaign-reconfigure">
      <bpmn:incoming>Flow_Fix_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_Fix_UploadAgain</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_Pay" name="Оплатить счет"
                   camunda:candidateUsers="${ownerUsername}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="paymentConfirmationUrl" label="Ссылка на оплату" type="string" />
          <camunda:formField id="paymentAttempted" label="Оплата выполнена во внешней системе" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Moderation_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_PayAgain</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_WaitResult</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:eventBasedGateway id="EventBasedGateway_PaymentResult" name="Ожидание оплаты">
      <bpmn:incoming>Flow_Pay_WaitResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_Succeeded</bpmn:outgoing>
      <bpmn:outgoing>Flow_Payment_Canceled</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="IntermediateMessage_PaymentSucceeded" name="Оплата получена">
      <bpmn:incoming>Flow_Payment_Succeeded</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSucceeded_Service</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PaymentSucceeded" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateMessage_PaymentCanceled" name="Оплата отменена">
      <bpmn:incoming>Flow_Payment_Canceled</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentCanceled_Service</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PaymentCanceled" />
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="ServiceTask_PaymentSucceeded" name="Зафиксировать оплату"
                      camunda:type="external" camunda:topic="payment-succeeded">
      <bpmn:incoming>Flow_PaymentSucceeded_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_Start</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="IntermediateTimer_WaitStart" name="Ожидание времени старта">
      <bpmn:incoming>Flow_Wait_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Start_Activate</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${startAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="ServiceTask_ActivateCampaign" name="Активировать кампанию"
                      camunda:type="external" camunda:topic="campaign-activate">
      <bpmn:incoming>Flow_Start_Activate</bpmn:incoming>
      <bpmn:outgoing>Flow_Active_Wait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:eventBasedGateway id="EventBasedGateway_ActiveWait" name="Ожидание завершения или паузы">
      <bpmn:incoming>Flow_Active_Wait</bpmn:incoming>
      <bpmn:incoming>Flow_Resume_ActiveWait</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Timer</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pause_Message</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="IntermediateTimer_EndAt" name="Достигнуто время окончания">
      <bpmn:incoming>Flow_End_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Stop</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${endAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateMessage_PauseRequested" name="Запрошена пауза">
      <bpmn:incoming>Flow_Pause_Message</bpmn:incoming>
      <bpmn:outgoing>Flow_Pause_Freeze</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PauseRequested" />
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="ServiceTask_FreezeActiveCampaign" name="Заморозить активную кампанию"
                      camunda:type="external" camunda:topic="campaign-freeze">
      <bpmn:incoming>Flow_Pause_Freeze</bpmn:incoming>
      <bpmn:outgoing>Flow_Freeze_Decide</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_DecideResumeOrStop" name="Возобновить или завершить"
                   camunda:candidateUsers="${ownerUsername}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="operationUsername" label="Пользователь" type="string" />
          <camunda:formField id="proceed" label="Возобновить кампанию" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Freeze_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_Decide_ResumeGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ResumeOrStop" name="Возобновить?" default="Flow_Decide_Stop">
      <bpmn:incoming>Flow_Decide_ResumeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Decide_Resume</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decide_Stop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_ResumeCampaign" name="Возобновить кампанию"
                      camunda:type="external" camunda:topic="campaign-resume">
      <bpmn:incoming>Flow_Decide_Resume</bpmn:incoming>
      <bpmn:outgoing>Flow_Resume_ActiveWait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_PaymentCanceled" name="Заморозить из-за отмены оплаты"
                      camunda:type="external" camunda:topic="payment-canceled">
      <bpmn:incoming>Flow_PaymentCanceled_Service</bpmn:incoming>
      <bpmn:outgoing>Flow_Canceled_RetryTask</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_RetryPaymentOrCancel" name="Повторить оплату или отменить"
                   camunda:candidateUsers="${ownerUsername}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="operationUsername" label="Пользователь" type="string" />
          <camunda:formField id="retryPayment" label="Повторить оплату" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Canceled_RetryTask</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_RetryPayment" name="Повторить?" default="Flow_Retry_Cancel">
      <bpmn:incoming>Flow_Retry_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Invoice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retry_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_RetryPaymentInvoice" name="Сформировать новый счет"
                      camunda:type="external" camunda:topic="payment-retry-invoice">
      <bpmn:incoming>Flow_Retry_Invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_PayAgain</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_StopCampaign" name="Остановить кампанию"
                      camunda:type="external" camunda:topic="campaign-stop">
      <bpmn:incoming>Flow_End_Stop</bpmn:incoming>
      <bpmn:incoming>Flow_Decide_Stop</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_Stop_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_CampaignFinished" name="Завершение">
      <bpmn:incoming>Flow_Stop_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_CreateDraft" sourceRef="StartEvent_CreateCampaign" targetRef="ServiceTask_CreateDraft" />
    <bpmn:sequenceFlow id="Flow_Draft_Configure" sourceRef="ServiceTask_CreateDraft" targetRef="UserTask_ConfigureCampaign" />
    <bpmn:sequenceFlow id="Flow_Configure_Service" sourceRef="UserTask_ConfigureCampaign" targetRef="ServiceTask_ConfigureCampaign" />
    <bpmn:sequenceFlow id="Flow_Configured_Upload" sourceRef="ServiceTask_ConfigureCampaign" targetRef="UserTask_UploadCreatives" />
    <bpmn:sequenceFlow id="Flow_Upload_Service" sourceRef="UserTask_UploadCreatives" targetRef="ServiceTask_ScheduleCreativeUpload" />
    <bpmn:sequenceFlow id="Flow_Upload_WaitResult" sourceRef="ServiceTask_ScheduleCreativeUpload" targetRef="IntermediateMessage_CreativeUploadFinished" />
    <bpmn:sequenceFlow id="Flow_Upload_ResultGateway" sourceRef="IntermediateMessage_CreativeUploadFinished" targetRef="Gateway_CreativeUploadResult" />
    <bpmn:sequenceFlow id="Flow_UploadFailed_Retry" sourceRef="Gateway_CreativeUploadResult" targetRef="UserTask_UploadCreatives">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creativeUploadStatus == 'FAILED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_UploadCompleted" sourceRef="Gateway_CreativeUploadResult" targetRef="Gateway_UploadMore" />
    <bpmn:sequenceFlow id="Flow_UploadMore_Yes" sourceRef="Gateway_UploadMore" targetRef="UserTask_UploadCreatives">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${uploadMore == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_UploadMore_No" sourceRef="Gateway_UploadMore" targetRef="UserTask_SubmitForCheck" />
    <bpmn:sequenceFlow id="Flow_Submit_Service" sourceRef="UserTask_SubmitForCheck" targetRef="ServiceTask_SubmitForModeration" />
    <bpmn:sequenceFlow id="Flow_Submit_Moderation" sourceRef="ServiceTask_SubmitForModeration" targetRef="UserTask_ManualModeration" />
    <bpmn:sequenceFlow id="Flow_Moderation_Service" sourceRef="UserTask_ManualModeration" targetRef="ServiceTask_ModerationDecision" />
    <bpmn:sequenceFlow id="Flow_Moderation_Gateway" sourceRef="ServiceTask_ModerationDecision" targetRef="Gateway_ModerationApproved" />
    <bpmn:sequenceFlow id="Flow_Moderation_Approved" sourceRef="Gateway_ModerationApproved" targetRef="UserTask_Pay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${moderationApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Moderation_Rejected" sourceRef="Gateway_ModerationApproved" targetRef="UserTask_FixAfterRejection" />
    <bpmn:sequenceFlow id="Flow_Fix_Service" sourceRef="UserTask_FixAfterRejection" targetRef="ServiceTask_ReconfigureAfterRejection" />
    <bpmn:sequenceFlow id="Flow_Fix_UploadAgain" sourceRef="ServiceTask_ReconfigureAfterRejection" targetRef="UserTask_UploadCreatives" />
    <bpmn:sequenceFlow id="Flow_Pay_WaitResult" sourceRef="UserTask_Pay" targetRef="EventBasedGateway_PaymentResult" />
    <bpmn:sequenceFlow id="Flow_Payment_Succeeded" sourceRef="EventBasedGateway_PaymentResult" targetRef="IntermediateMessage_PaymentSucceeded" />
    <bpmn:sequenceFlow id="Flow_Payment_Canceled" sourceRef="EventBasedGateway_PaymentResult" targetRef="IntermediateMessage_PaymentCanceled" />
    <bpmn:sequenceFlow id="Flow_PaymentSucceeded_Service" sourceRef="IntermediateMessage_PaymentSucceeded" targetRef="ServiceTask_PaymentSucceeded" />
    <bpmn:sequenceFlow id="Flow_PaymentCanceled_Service" sourceRef="IntermediateMessage_PaymentCanceled" targetRef="ServiceTask_PaymentCanceled" />
    <bpmn:sequenceFlow id="Flow_Wait_Start" sourceRef="ServiceTask_PaymentSucceeded" targetRef="IntermediateTimer_WaitStart" />
    <bpmn:sequenceFlow id="Flow_Start_Activate" sourceRef="IntermediateTimer_WaitStart" targetRef="ServiceTask_ActivateCampaign" />
    <bpmn:sequenceFlow id="Flow_Active_Wait" sourceRef="ServiceTask_ActivateCampaign" targetRef="EventBasedGateway_ActiveWait" />
    <bpmn:sequenceFlow id="Flow_End_Timer" sourceRef="EventBasedGateway_ActiveWait" targetRef="IntermediateTimer_EndAt" />
    <bpmn:sequenceFlow id="Flow_Pause_Message" sourceRef="EventBasedGateway_ActiveWait" targetRef="IntermediateMessage_PauseRequested" />
    <bpmn:sequenceFlow id="Flow_End_Stop" sourceRef="IntermediateTimer_EndAt" targetRef="ServiceTask_StopCampaign" />
    <bpmn:sequenceFlow id="Flow_Pause_Freeze" sourceRef="IntermediateMessage_PauseRequested" targetRef="ServiceTask_FreezeActiveCampaign" />
    <bpmn:sequenceFlow id="Flow_Freeze_Decide" sourceRef="ServiceTask_FreezeActiveCampaign" targetRef="UserTask_DecideResumeOrStop" />
    <bpmn:sequenceFlow id="Flow_Decide_ResumeGateway" sourceRef="UserTask_DecideResumeOrStop" targetRef="Gateway_ResumeOrStop" />
    <bpmn:sequenceFlow id="Flow_Decide_Resume" sourceRef="Gateway_ResumeOrStop" targetRef="ServiceTask_ResumeCampaign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${proceed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decide_Stop" sourceRef="Gateway_ResumeOrStop" targetRef="ServiceTask_StopCampaign" />
    <bpmn:sequenceFlow id="Flow_Resume_ActiveWait" sourceRef="ServiceTask_ResumeCampaign" targetRef="EventBasedGateway_ActiveWait" />
    <bpmn:sequenceFlow id="Flow_Canceled_RetryTask" sourceRef="ServiceTask_PaymentCanceled" targetRef="UserTask_RetryPaymentOrCancel" />
    <bpmn:sequenceFlow id="Flow_Retry_Gateway" sourceRef="UserTask_RetryPaymentOrCancel" targetRef="Gateway_RetryPayment" />
    <bpmn:sequenceFlow id="Flow_Retry_Invoice" sourceRef="Gateway_RetryPayment" targetRef="ServiceTask_RetryPaymentInvoice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${retryPayment == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Retry_Cancel" sourceRef="Gateway_RetryPayment" targetRef="ServiceTask_StopCampaign" />
    <bpmn:sequenceFlow id="Flow_Retry_PayAgain" sourceRef="ServiceTask_RetryPaymentInvoice" targetRef="UserTask_Pay" />
    <bpmn:sequenceFlow id="Flow_Stop_End" sourceRef="ServiceTask_StopCampaign" targetRef="EndEvent_CampaignFinished" />
  </bpmn:process>
</bpmn:definitions>
